@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@namespace Warlocks.UI

<root class="hc1 landing-page">
	<div class="landing-left">

		@* Game logo / title *@
		<div class="landing-logo">
			<label class="landing-game-title">WARLOCKS</label>
			<label class="landing-game-subtitle">WIZARDING WARFARE</label>
		</div>

		@* Navigation items *@
		<nav class="landing-nav">
			<a class="landing-nav-item" href="/play">PLAY</a>

			<div class="landing-nav-item soon">
				SPELLS
				<label class="soon-badge">SOON</label>
			</div>

			<div class="landing-nav-item soon">
				HOW TO PLAY
				<label class="soon-badge">SOON</label>
			</div>

			<a class="landing-nav-item" href="/settings">SETTINGS</a>
		</nav>

		@* Exit game — separated visually *@
		<div class="landing-exit" onclick=@Quit>EXIT GAME</div>

	</div>
</root>

@code
{
	void Quit()
	{
		DialogModal.Show( "Tem certeza que quer sair?", "Sair", "Cancelar", () => Game.Close() );
	}
}
