@using Sandbox;
@using Sandbox.Network;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@namespace Warlocks.UI

<root class="hc1 play-page">

	@* Left panel: mode selection *@
	<div class="play-page-left">
		<div class="play-page-header">
			<label>Select Play Mode:</label>
		</div>

		<div class="play-mode-list">
			@* Play Warlocks *@
			<div class="play-mode-item @( State == MatchState.Searching || State == MatchState.InLobby ? "active" : "" ) @( State != MatchState.Idle ? "locked" : "" )"
				onclick=@OnClickPlayWarlocks>
				<div class="play-mode-item-inner">
					<label class="play-mode-title">Play Warlocks</label>

					@if ( State == MatchState.Idle )
					{
						<label class="play-mode-desc">Queue up for a standard match against other players online.</label>
					}
					else if ( State == MatchState.Searching )
					{
						<label class="play-mode-desc searching">Looking for a match...</label>
						<label class="play-mode-queue">@QueueMessage</label>
					}
					else if ( State == MatchState.InLobby )
					{
						<label class="play-mode-desc searching">Waiting for players... (@LobbyPlayerCount / @LobbyMaxPlayers)</label>
						<div class="play-mode-actions">
							@if ( IsHost )
							{
								<div class="button standard smaller" onclick=@ForceStart>Start Match</div>
							}
						</div>
					}
				</div>

				@if ( State == MatchState.Searching || State == MatchState.InLobby )
				{
					<div class="button standard smaller cancel-btn" onclick=@CancelSearch>Cancel</div>
				}
			</div>

			@* Sandbox Mode *@
			<div class="play-mode-item @( State != MatchState.Idle ? "locked" : "" )" onclick=@OnClickSandbox>
				<div class="play-mode-item-inner">
					<label class="play-mode-title">Sandbox Mode</label>
					<label class="play-mode-desc">Test your skills and build in freeform. Available for solo players.</label>
				</div>
			</div>
		</div>

		@* Party panel *@
		<div class="party-panel">
			<div class="party-header">
				<label>Party</label>
				@if ( HasParty )
				{
					<div class="button standard smaller" onclick=@InviteFriend>+ Invite</div>
				}
			</div>
			<div class="party-members">
				@if ( HasParty )
				{
					@foreach ( var member in PartyMembers )
					{
						<div class="party-member">
							<label>@member</label>
						</div>
					}
				}
				else
				{
					<label class="party-empty">No party. Invite friends to play together!</label>
					<div class="button standard smaller" onclick=@InviteFriend>Invite friends</div>
				}
			</div>
		</div>
	</div>

	@* Right area: background art (kept empty, scene renders behind) *@
	<div class="play-page-right" />

</root>

@code
{
	public enum MatchState { Idle, Searching, InLobby }

	public MatchState State { get; private set; } = MatchState.Idle;
	public string QueueMessage { get; private set; } = "";
	public int LobbyPlayerCount { get; private set; } = 1;
	public int LobbyMaxPlayers { get; private set; } = 10;
	public bool IsHost { get; private set; } = false;

	public bool HasParty => false; // TODO: PartyRoom.Current?.Members?.Count > 1
	public IEnumerable<string> PartyMembers => Enumerable.Empty<string>(); // TODO: PartyRoom.Current?.Members

	public void OnNavigationOpen()
	{
		if ( MainMenuRoot.Instance.IsValid() )
			MainMenuRoot.Instance.SetBlur( true );

		State = MatchState.Idle;
		StateHasChanged();
	}

	public void OnNavigationClose()
	{
		if ( MainMenuRoot.Instance.IsValid() )
			MainMenuRoot.Instance.SetBlur( false );

		CancelSearch();
	}

	private void OnClickPlayWarlocks()
	{
		if ( State != MatchState.Idle ) return;
		_ = FindOrCreateMatch();
	}

	private void OnClickSandbox()
	{
		if ( State != MatchState.Idle ) return;
		LoadSandboxMode();
	}

	private void LoadSandboxMode()
	{
		var sandboxScene = ResourceLibrary.Get<SceneFile>( "scenes/minimal.scene" );
		if ( sandboxScene is null )
		{
			Log.Warning( "PlayPage: Could not find minimal.scene for Sandbox Mode." );
			return;
		}

		// Tell the network manager this is a local (non-multiplayer) session
		MatchmakingSystem.IsMultiplayerSession = false;
		Game.ActiveScene.Load( sandboxScene );
	}

	private async Task FindOrCreateMatch()
	{
		State = MatchState.Searching;
		QueueMessage = "Connecting...";
		StateHasChanged();

		try
		{
			await MatchmakingSystem.FindOrCreateMatch( OnMatchFound, OnLobbyCreated );
		}
		catch ( Exception e )
		{
			Log.Warning( $"PlayPage: Matchmaking error: {e.Message}" );
			State = MatchState.Idle;
			StateHasChanged();
		}
	}

	private void OnMatchFound( LobbyInformation lobby )
	{
		// Successfully joined an existing lobby — transition should happen automatically
		// as the host will load the scene and clients follow
		QueueMessage = "Match found! Connecting...";
		StateHasChanged();
	}

	private void OnLobbyCreated( int playerCount, int maxPlayers )
	{
		State = MatchState.InLobby;
		IsHost = true;
		LobbyPlayerCount = playerCount;
		LobbyMaxPlayers = maxPlayers;
		QueueMessage = $"Waiting for players... ({playerCount}/{maxPlayers})";
		StateHasChanged();
	}

	private void ForceStart()
	{
		if ( !IsHost ) return;
		MatchmakingSystem.ForceStartMatch();
	}

	private void CancelSearch()
	{
		MatchmakingSystem.CancelSearch();
		State = MatchState.Idle;
		IsHost = false;
		StateHasChanged();
	}

	private void InviteFriend()
	{
		// TODO: PartyRoom.Current?.InviteFriend()
		Log.Info( "PlayPage: Invite friend called." );
	}
}
