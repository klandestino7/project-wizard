@using Sandbox;
@using Sandbox.Network;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@namespace Warlocks.UI

<root class="hc1 play-page">

	@* Left panel: mode selection *@
	<div class="play-page-left">
		<div class="play-page-topbar">
			<a class="play-page-back" href="/"> ← Back</a>
		</div>

		@if ( ShowServerOfflineNotice )
		{
			<div class="play-page-server-warning">
				<label>Matchmaking server is currently offline. Play Warlocks is temporarily unavailable.</label>
			</div>
		}

		<div class="play-page-header">
			<label>Select Play Mode:</label>
		</div>

		<div class="play-mode-list">

			@* ── Play Warlocks ── *@
			<div class="play-mode-item @ActiveClass @PlayWarlocksClass" >
				<div class="play-mode-item-inner" onclick=@OnClickPlayWarlocks>
					<label class="play-mode-title">Play Warlocks</label>

					@if ( IsCheckingServerStatus )
					{
						<label class="play-mode-desc">Checking server status...</label>
					}
					else if ( IsServerOffline )
					{
						<label class="play-mode-desc offline">Server offline. Try again later.</label>
					}
					else if ( IsIdle )
					{
						<label class="play-mode-desc">Queue up for a standard match against other players online.</label>
					}
					else if ( IsSearching )
					{
						<label class="play-mode-desc searching">Looking for a match...</label>
					}
					else if ( IsMatchProposed )
					{
						<label class="play-mode-desc searching">
							Players accepted: @MatchmakingSystem.AcceptedCount.ToString("N0") / @MatchmakingSystem.TotalPlayers.ToString("N0")
						</label>
					}
					else if ( IsStartingMatch )
					{
						<label class="play-mode-desc searching">Starting match...</label>
					}
					else if ( IsWaitingForLobby )
					{
						<label class="play-mode-desc searching">Waiting for the host lobby...</label>
					}
				</div>

				@if ( !IsIdle )
				{
					<div class="button standard smaller cancel-btn" onclick=@CancelSearch>Cancel</div>
				}
			</div>

			@* ── Sandbox Mode ── *@
			<div class="play-mode-item @LockedClass" onclick=@OnClickSandbox>
				<div class="play-mode-item-inner">
					<label class="play-mode-title">Sandbox Mode</label>
					<label class="play-mode-desc">Test your skills and build in freeform. Available for solo players.</label>
				</div>
			</div>

		</div>

		@* ── Party panel ── *@
		<div class="party-panel">
			<div class="party-header">
				<label>Party</label>
				<div class="button standard smaller" onclick=@InviteFriend>+ Invite</div>
			</div>
			<div class="party-members">
				@if ( Connection.All.Count() > 1 )
				{
					@foreach ( var conn in Connection.All )
					{
						<div class="party-member">
							<label>@conn.DisplayName</label>
						</div>
					}
				}
				else
				{
					<label class="party-empty">No party. Invite friends to play together!</label>
				}
			</div>
		</div>
	</div>

	<div class="play-page-right" />

	<MatchAcceptPopup />

</root>

@code
{
	private int MaxPlayers => MatchmakingSystem.Instance.IsValid() ? MatchmakingSystem.Instance.MaxPlayers : 10;
	private bool IsCheckingServerStatus { get; set; } = true;
	private bool IsServerOffline { get; set; }

	private bool IsIdle => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.Idle;
	private bool IsSearching =>
		MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.Connecting ||
		MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.Queued;
	private bool IsMatchProposed => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.MatchProposed;
	private bool IsWaitingForLobby => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.WaitingForLobby;
	private bool IsStartingMatch => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.Starting;

	private string ActiveClass => !IsIdle ? "active" : "";
	private string LockedClass => !IsIdle ? "locked" : "";
	private string PlayWarlocksClass => !IsIdle ? "locked" : IsCheckingServerStatus || IsServerOffline ? "disabled" : "";
	private bool ShowServerOfflineNotice => IsServerOffline && IsIdle;

	public void OnNavigationOpen()
	{
		if ( MainMenuRoot.Instance.IsValid() )
			MainMenuRoot.Instance.SetBlur( true );

		MatchmakingSystem.OnStateChanged += Refresh;
		_ = RefreshServerStatus();
	}

	public void OnNavigationClose()
	{
		if ( MainMenuRoot.Instance.IsValid() )
			MainMenuRoot.Instance.SetBlur( false );

		MatchmakingSystem.OnStateChanged -= Refresh;
	}

	private void Refresh() => StateHasChanged();

	private async Task RefreshServerStatus()
	{
		IsCheckingServerStatus = true;
		IsServerOffline = false;
		StateHasChanged();

		try
		{
			IsServerOffline = !await MatchmakingSystem.IsServerAvailable();
		}
		catch ( Exception e )
		{
			Log.Warning( $"PlayPage: Failed to check matchmaking server status - {e.Message}" );
			IsServerOffline = true;
		}
		finally
		{
			IsCheckingServerStatus = false;
			StateHasChanged();
		}
	}

	private void OnClickPlayWarlocks()
	{
		if ( !IsIdle || IsCheckingServerStatus || IsServerOffline ) return;
		_ = MatchmakingSystem.FindOrCreateMatch();
	}

	private void OnClickSandbox()
	{
		if ( !IsIdle ) return;
		MatchmakingSystem.IsMultiplayerSession = false;
		var scene = WarlocksPlaylist.GetWarlocksScene();
		if ( scene is not null )
			Game.ActiveScene.Load( scene );
	}

	private void CancelSearch()
	{
		if ( !IsIdle )
			MatchmakingSystem.CancelSearch();
	}

	private void InviteFriend()
	{
		// TODO: PartyRoom.Current?.InviteFriend()
		Log.Info( "PlayPage: InviteFriend called." );
	}
}
