@using Sandbox;
@using Sandbox.Network;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@namespace Warlocks.UI

<root class="hc1 play-page">

	@* Left panel: mode selection *@
	<div class="play-page-left">
		<div class="play-page-header">
			<label>Select Play Mode:</label>
		</div>

		<div class="play-mode-list">

			@* ── Play Warlocks ── *@
			<div class="play-mode-item @ActiveClass @LockedClass" >
				<div class="play-mode-item-inner" onclick=@OnClickPlayWarlocks>
					<label class="play-mode-title">Play Warlocks</label>

					@if ( IsIdle )
					{
						<label class="play-mode-desc">Queue up for a standard match against other players online.</label>
					}
					else if ( IsSearching )
					{
						<label class="play-mode-desc searching">Looking for a match...</label>
					}
					else if ( IsInLobby )
					{
						<label class="play-mode-desc searching">
							Waiting for players... @MatchmakingSystem.CurrentPlayerCount.ToString("N0") / @MaxPlayers.ToString("N0")
						</label>
					}
					else if ( IsJoinedLobby )
					{
						<label class="play-mode-desc searching">Match found! Waiting for host to start...</label>
					}
				</div>

				@if ( !IsIdle )
				{
					<div class="button standard smaller cancel-btn" onclick=@CancelSearch>Cancel</div>
				}
			</div>

			@* ── Sandbox Mode ── *@
			<div class="play-mode-item @LockedClass" onclick=@OnClickSandbox>
				<div class="play-mode-item-inner">
					<label class="play-mode-title">Sandbox Mode</label>
					<label class="play-mode-desc">Test your skills and build in freeform. Available for solo players.</label>
				</div>
			</div>

		</div>

		@* ── Party panel ── *@
		<div class="party-panel">
			<div class="party-header">
				<label>Party</label>
				<div class="button standard smaller" onclick=@InviteFriend>+ Invite</div>
			</div>
			<div class="party-members">
				@if ( Connection.All.Count() > 1 )
				{
					@foreach ( var conn in Connection.All )
					{
						<div class="party-member">
							<label>@conn.DisplayName</label>
						</div>
					}
				}
				else
				{
					<label class="party-empty">No party. Invite friends to play together!</label>
				}
			</div>
		</div>
	</div>

	<div class="play-page-right" />

	<MatchAcceptPopup />

</root>

@code
{
	private int MaxPlayers => MatchmakingSystem.Instance.IsValid() ? MatchmakingSystem.Instance.MaxPlayers : 10;

	private bool IsIdle      => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.Idle;
	private bool IsSearching => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.Searching;
	private bool IsInLobby   => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.InLobby;
	private bool IsJoinedLobby => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.JoinedLobby;

	private string ActiveClass => IsSearching || IsInLobby || IsJoinedLobby ? "active" : "";
	private string LockedClass => !IsIdle ? "locked" : "";

	public void OnNavigationOpen()
	{
		if ( MainMenuRoot.Instance.IsValid() )
			MainMenuRoot.Instance.SetBlur( true );

		MatchmakingSystem.OnStateChanged += Refresh;
	}

	public void OnNavigationClose()
	{
		if ( MainMenuRoot.Instance.IsValid() )
			MainMenuRoot.Instance.SetBlur( false );

		MatchmakingSystem.OnStateChanged -= Refresh;
	}

	private void Refresh() => StateHasChanged();

	private void OnClickPlayWarlocks()
	{
		if ( !IsIdle ) return;
		_ = MatchmakingSystem.FindOrCreateMatch();
	}

	private void OnClickSandbox()
	{
		if ( !IsIdle ) return;
		MatchmakingSystem.IsMultiplayerSession = false;
		var scene = ResourceLibrary.Get<SceneFile>( "scenes/minimal.scene" );
		if ( scene is not null )
			Game.ActiveScene.Load( scene );
	}

	private void CancelSearch()
	{
		if (IsInLobby || IsSearching)
			MatchmakingSystem.CancelSearch();
	}

	private void InviteFriend()
	{
		// TODO: PartyRoom.Current?.InviteFriend()
		Log.Info( "PlayPage: InviteFriend called." );
	}
}
