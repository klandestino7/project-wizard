@namespace Warlocks.UI
@attribute [StyleSheet]

<root class="@(Selected ? "selected" : "")">
    <div class="background" style="@BuildBackgroundStyle()">
        <div class="grow" />
    </div>

    <div class="header">
        <label class="vital uppercase emphasis">@Map.GetMetadata( "Title" )</label>
    </div>
</root>

@code
{
    public SceneFile Map { get; set; }
    public Action<SceneFile> OnSelected { get; set; }
    public bool Selected { get; set; }

    protected override void OnClick( MousePanelEvent e )
    {
        OnSelected?.Invoke( Map );
    }

    private string BuildBackgroundStyle()
    {
        var image = Map?.GetMetadata( "Image", null );
        return string.IsNullOrWhiteSpace( image )
            ? "background-image: none;"
            : $"background-image: url(\"{image}\");";
    }
}
