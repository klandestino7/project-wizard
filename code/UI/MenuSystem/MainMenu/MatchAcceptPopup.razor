@using Sandbox;
@using Sandbox.Network;
@using Sandbox.UI;

@inherits Panel
@namespace Warlocks.UI

@if ( IsVisible )
{
	<root class="match-accept-overlay">
		<div class="match-accept-box">

			@* Header *@
			<div class="match-accept-header">
				<label class="match-accept-title">PARTIDA ENCONTRADA</label>
				<label class="match-accept-map">@(MatchmakingSystem.IsHost ? "VOCÊ É O ANFITRIÃO" : "")</label>
			</div>

			@* Countdown *@
			<div class="match-accept-countdown">
				<label class="countdown-number">@MatchmakingSystem.CountdownSeconds</label>
				<label class="countdown-label">segundos</label>
			</div>

			@* Accept progress *@
			<div class="match-accept-players">
				<label class="players-header">
					PRONTOS @MatchmakingSystem.AcceptedCount / @MatchmakingSystem.TotalPlayers
				</label>
				<div class="accept-pips">
					@for ( int i = 0; i < MatchmakingSystem.TotalPlayers; i++ )
					{
						<div class="accept-pip @(i < MatchmakingSystem.AcceptedCount ? "ready" : "waiting")"></div>
					}
				</div>
			</div>

			@* Actions *@
			<div class="match-accept-actions">
				@if ( !_hasResponded )
				{
					<div class="button standard action match-accept-btn" onclick=@Accept>
						ACEITAR
					</div>
					<div class="button standard match-decline-btn" onclick=@Decline>
						RECUSAR
					</div>
				}
				else
				{
					<div class="match-accept-waiting">
						<label>Aguardando outros jogadores...</label>
					</div>
					<div class="button standard match-decline-btn" onclick=@Decline>
						SAIR DA FILA
					</div>
				}
			</div>

		</div>
	</root>
}

@code
{
	private bool IsVisible => MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.MatchProposed
	                       || MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.WaitingForLobby
	                       || MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.Starting;

	private bool _hasResponded;

	protected override void OnAfterTreeRender( bool firstTime )
	{
		if ( !firstTime ) return;
		MatchmakingSystem.OnStateChanged += OnMatchStateChanged;
	}

	private void OnMatchStateChanged()
	{
		// Reset response state when a new proposal arrives
		if ( MatchmakingSystem.CurrentState == MatchmakingSystem.SearchState.MatchProposed )
			_hasResponded = false;

		StateHasChanged();
	}

	private void Accept()
	{
		if ( _hasResponded ) return;
		_hasResponded = true;
		MatchmakingSystem.AcceptMatch();
	}

	private void Decline()
	{
		MatchmakingSystem.DeclineMatch();
	}
}
