@using Sandbox
@using Sandbox.UI
@inherits Panel
@attribute [StyleSheet]

@namespace Warlocks.UI

@if ( !Player.IsValid() ) return;

<root>
@if ( IsOpen && Player != null && Deck != null )
{
	<div class="wiz-overlay @( IsOpen ? "visible" : "" )">
		<div class="wiz-left">
			<div class="wiz-panel-title">BUILD</div>
			<div class="wiz-team-list">
				@RenderBuildSummary()
				@RenderTeamList()
			</div>
		</div>

		<div class="wiz-center">
			<div class="wiz-center-hdr">
				<div class="wiz-gold">
					<div class="wiz-coin"></div>
					<span>@EnergyLabel</span>
				</div>
				<div class="wiz-tabs">
					<div class="wiz-tab @( ActiveTab == Tab.Spells ? "active" : "" )"
					     onclick=@( () => ActiveTab = Tab.Spells )>SPELLS</div>
					<div class="wiz-tab @( ActiveTab == Tab.Identity ? "active" : "" )"
					     onclick=@( () => ActiveTab = Tab.Identity )>IDENTITY</div>
				</div>
				<div class="wiz-hint-txt">[ B ] Close</div>
			</div>

			@if ( ActiveTab == Tab.Spells )
			{
				<div class="wiz-spell-container">
					<div class="wiz-spell-grid">
						@RenderSpellCol( "Ofensiva", "OFFENSE" )
						@RenderSpellCol( "Controle", "CONTROL" )
						@RenderSpellCol( "Defesa", "DEFENSE" )
						@RenderSpellCol( "Utilidade", "UTILITY" )
					</div>
				</div>

				<div class="wiz-deck-bar">
					<div class="wiz-deck-label">ACTIVE SPELLS</div>
					<div class="wiz-deck-row">
						@RenderDeckSlot( "1", 0 )
						@RenderDeckSlot( "2", 1 )
						@RenderDeckSlot( "3", 2 )
						@RenderDeckSlot( "4", 3 )
						@RenderDeckSlot( "5", 4 )
						@RenderDeckSlot( "6", 5 )
					</div>
				</div>
			}
			else
			{
				@RenderIdentityPanel()
			}
		</div>

		<div class="wiz-right">
			@RenderRoundInfo()
			@if ( ActiveTab == Tab.Spells && SelectedIdx >= 0 )
			{
				@RenderDetail( SelectedIdx )
			}
			else
			{
				<div class="wiz-right-empty"></div>
			}

			@if ( ActiveTab == Tab.Spells )
			{
				@RenderConsumablesPanel()
			}
		</div>
	</div>
}
</root>

@code {
	enum Tab { Spells, Identity }

	public Client LocalClient => Client.Local?.IsValid() == true ? Client.Local : Client.Viewer;
	public PlayerPawn Player => LocalClient?.PlayerPawn ?? PlayerPawn.Local;
	RoundManager Round => RoundManager.Instance;
	SpellsDeck Deck => Player?.SpellsDeck;
	PlayerBuildComponent Build => Player?.PlayerBuild;
	BuildValidationResult Validation => Deck?.ValidateCurrentLoadout();

	int SelectedIdx = -1;
	int PendingSlot = -1;
	Tab ActiveTab = Tab.Spells;

	const int MaxTeamSize = 5;

	private bool IsOpen;

	string EnergyLabel => Validation is null || Build is null
		? "0 / 0"
		: $"{Validation.EnergyUsed} / {Build.EnergyBudget}";
	string BalanceLabel => $"${Player?.Client?.Balance ?? 0}";

	void Toggle()
	{
		IsOpen = !IsOpen;
	}

	public override void Tick()
	{
		var inBuildPhase = Round?.State == RoundState.BuildPhase;

		if ( inBuildPhase )
		{
			// Force open and lock during BuildPhase — player must use the panel
			IsOpen = true;
		}
		else if ( Player?.CanConfigureBuild is true )
		{
			if ( Input.Pressed( "BuyMenu" ) )
				Toggle();
		}
		else
		{
			IsOpen = false;
		}
	}

	// ─── Identity panel ───────────────────────────────────────────────

	RenderFragment RenderIdentityPanel() => __builder =>
	{
		bool affinityEnabled   = Round?.EnableAffinity   ?? true;
		bool disciplineEnabled = Round?.EnableDiscipline ?? true;
		bool passiveEnabled    = Round?.EnablePassive    ?? true;

		<div class="wiz-identity">
			<div class="wiz-id-section @( affinityEnabled ? "" : "locked" )">
				<div class="wiz-id-title">AFFINITY @( affinityEnabled ? "" : "— DISABLED" )</div>
				<div class="wiz-id-desc">Buffs spells of the matching element.</div>
				@if ( affinityEnabled )
				{
					<div class="wiz-id-options">
						@foreach ( AffinityType aff in Enum.GetValues( typeof(AffinityType) ) )
						{
							var a = aff;
							bool sel = Build?.Affinity == a;
							<div class="wiz-id-opt @( sel ? "selected" : "" )" onclick=@( () => Build?.ClientSetAffinity( a ) )>
								<div class="wiz-id-opt-name">@a.ToString().ToUpper()</div>
								<div class="wiz-id-opt-sub">@AffinityDescription( a )</div>
							</div>
						}
					</div>
				}
			</div>

			<div class="wiz-id-section @( disciplineEnabled ? "" : "locked" )">
				<div class="wiz-id-title">DISCIPLINE @( disciplineEnabled ? "" : "— DISABLED" )</div>
				<div class="wiz-id-desc">Defines your combat profile.</div>
				@if ( disciplineEnabled )
				{
					<div class="wiz-id-options">
						@foreach ( DisciplineType disc in Enum.GetValues( typeof(DisciplineType) ) )
						{
							var d = disc;
							bool sel = Build?.Discipline == d;
							<div class="wiz-id-opt @( sel ? "selected" : "" )" onclick=@( () => Build?.ClientSetDiscipline( d ) )>
								<div class="wiz-id-opt-name">@d.ToString().ToUpper()</div>
								<div class="wiz-id-opt-sub">@DisciplineDescription( d )</div>
							</div>
						}
					</div>
				}
			</div>

			<div class="wiz-id-section @( passiveEnabled ? "" : "locked" )">
				<div class="wiz-id-title">PASSIVE @( passiveEnabled ? "" : "— DISABLED" )</div>
				<div class="wiz-id-desc">A permanent trait that shapes your playstyle.</div>
				@if ( passiveEnabled )
				{
					<div class="wiz-id-options">
						@foreach ( PassiveType pass in Enum.GetValues( typeof(PassiveType) ) )
						{
							var p = pass;
							bool sel = Build?.Passive == p;
							<div class="wiz-id-opt @( sel ? "selected" : "" )" onclick=@( () => Build?.ClientSetPassive( p ) )>
								<div class="wiz-id-opt-name">@p.ToString().ToUpper()</div>
								<div class="wiz-id-opt-sub">@PassiveDescription( p )</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	};

	static string AffinityDescription( AffinityType a ) => a switch
	{
		AffinityType.Fire   => "+15% damage, applies burn",
		AffinityType.Ice    => "+20% effect duration",
		AffinityType.Arcane => "-15% cooldown",
		AffinityType.Shadow => "-10% mana cost",
		_                   => "Balanced with no bonus"
	};

	static string DisciplineDescription( DisciplineType d ) => d switch
	{
		DisciplineType.Duelist    => "+dmg on offense, -efficiency on defense",
		DisciplineType.Guardian   => "+power on defense, -mobility",
		DisciplineType.Controller => "+duration on control, -direct damage",
		_                         => "No modifiers"
	};

	static string PassiveDescription( PassiveType p ) => p switch
	{
		PassiveType.SwiftCaster  => "+20% move speed for 2s after casting",
		PassiveType.ManaSurge    => "Restore 12% of damage dealt as mana",
		PassiveType.Executioner  => "Reset all cooldowns on kill",
		_                        => "No passive"
	};

	// ─── Spell panel ──────────────────────────────────────────────────

	RenderFragment RenderBuildSummary() => __builder =>
	{
		<div class="wiz-mate is-local">
			<div class="wiz-avatar">W</div>
			<div class="wiz-mate-body">
				<div class="wiz-mate-name">Affinity: @Build?.Affinity</div>
				<div class="wiz-mate-stats">
					<span class="wiz-mg">Discipline: @Build?.Discipline</span>
				</div>
				<div class="wiz-mate-stats">
					<span class="wiz-mm">Passive: @Build?.Passive</span>
				</div>
				<div class="wiz-mate-stats">
					<span class="wiz-mm">Energy: @EnergyLabel</span>
				</div>
				@if ( Validation?.Errors.Count > 0 )
				{
					<div class="wiz-mate-stats">
						<span class="wiz-mg">Invalid build</span>
					</div>
				}
			</div>
		</div>
	};

	RenderFragment RenderTeamList() => __builder =>
	{
		int mateCount = 0;

		foreach ( var p in Game.ActiveScene.GetAllComponents<PlayerPawn>() )
		{
			if ( !p.IsValid() || Player == null || p.Team != Player.Team || !p.IsLocallyControlled )
				continue;

			RenderMate( p )( __builder );
			mateCount++;
		}

		foreach ( var p in Game.ActiveScene.GetAllComponents<PlayerPawn>() )
		{
			if ( !p.IsValid() || Player == null || p.Team != Player.Team || p.IsLocallyControlled )
				continue;

			RenderMate( p )( __builder );
			mateCount++;
		}

		for ( int i = mateCount; i < MaxTeamSize; i++ )
		{
			<div class="wiz-mate-empty"></div>
		}
	};

	RenderFragment RenderMate( PlayerPawn mate ) => __builder =>
	{
		bool isLocal = mate.IsLocallyControlled;
		bool alive = mate.IsAlive;
		var md = mate.SpellsDeck;
		var ms = mate.Components.Get<ManaSystem>();
		string letter = mate.DisplayName.Length > 0 ? mate.DisplayName.Substring( 0, 1 ).ToUpper() : "?";

		<div class="wiz-mate @( isLocal ? "is-local" : "" ) @( alive ? "" : "is-dead" )">
			<div class="wiz-avatar">@letter</div>
			<div class="wiz-mate-body">
				<div class="wiz-mate-name">@mate.DisplayName</div>
				<div class="wiz-mate-stats">
					<span class="wiz-mg">@mate.PlayerBuild?.Affinity</span>
					@if ( ms != null )
					{
						<span class="wiz-mm">Mana @( (int)ms.Mana )</span>
					}
				</div>
				<div class="wiz-mate-deck">
					@if ( md != null )
					{
						@for ( int s = 0; s < SpellsDeck.RuntimeSlotCount; s++ )
						{
							int cidx = md.GetSlotIdx( s );
							bool has = cidx >= 0;
							string ac = has ? SpellCatalog.All[cidx].AccentColor : "transparent";
							<div class="wiz-ms @( has ? "filled" : "" )" style="border-color: @ac;">
								@if ( has )
								{
									<span style="color: @ac;">@SpellCatalog.All[cidx].Name.Substring( 0, 1 )</span>
								}
							</div>
						}
					}
				</div>
			</div>
		</div>
	};

	RenderFragment RenderSpellCol( string cat, string label ) => __builder =>
	{
		<div class="wiz-col wiz-col-bg-@label.ToLower()">
			<div class="wiz-col-hdr">@label</div>
			<div class="wiz-col-body">
				@for ( int i = 0; i < SpellCatalog.All.Length; i++ )
				{
					var entry = SpellCatalog.All[i];
					if ( entry.Category != cat ) continue;

					int idx = i;
					bool selected = Deck.IsOwned( idx );
					int tier = Deck.GetTier( idx );
					bool active = SelectedIdx == idx;

					<div class="wiz-sc @( selected ? "owned" : "" ) @( active ? "sel" : "" )"
					     onclick=@( () => SelectSpell( idx ) )>
						<div class="wiz-sc-icon" style="border-color: @entry.AccentColor;">
							<div class="wiz-sc-dot" style="@BuildImageStyle( entry.Image )"></div>
						</div>
						<div class="wiz-sc-info">
							<div class="wiz-sc-name">@entry.Name.ToUpper()</div>
							<div class="wiz-sc-cost">
								@if ( selected )
								{
									<span class="wiz-tier">T@tier</span>
								}
								else
								{
									<span class="wiz-star">E</span><span>@entry.EnergyCost</span>
								}
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	};

	RenderFragment RenderDeckSlot( string key, int slot ) => __builder =>
	{
		int cidx = Deck.GetSlotIdx( slot );
		bool filled = cidx >= 0;
		bool pending = PendingSlot == slot;
		string acc = filled ? SpellCatalog.All[cidx].AccentColor : "transparent";
		string name = filled ? SpellCatalog.All[cidx].Name : "";

		<div class="wiz-ds @( filled ? "filled" : "" ) @( pending ? "pending" : "" )"
		     onclick=@( () => ClickSlot( slot ) )>
			@if ( filled )
			{
				<div class="wiz-ds-ring" style="border-color: @acc;">
					<span style="color: @acc;">@( name.Length > 0 ? name.Substring( 0, 1 ) : "" )</span>
				</div>
				<div class="wiz-ds-name" style="color: @acc;">@name.ToUpper()</div>
				<button class="wiz-ds-rm" onclick=@( () => Unassign( slot ) )>X</button>
			}
			else
			{
				<div class="wiz-ds-empty"></div>
				@if ( pending )
				{
					<div class="wiz-ds-hint">select spell</div>
				}
			}
			<div class="wiz-ds-key">@key</div>
		</div>
	};

	
	string GetStateLabel() => Round?.State switch
	{
		RoundState.BuildPhase => "BUILD PHASE",
		RoundState.BuyPhase => "PREPARATION",
		RoundState.Combat => "COMBATE",
		RoundState.PostRound => "FIM DE ROUND",
		RoundState.MatchEnd => "PARTIDA ENCERRADA",
		_ => ""
	};

	RenderFragment RenderRoundInfo() => __builder =>
	{
		int roundNum = Round?.CurrentRound ?? 0;
		int aurors = Round?.AurorScore ?? 0;
		int dark = Round?.ComensalScore ?? 0;
		float t = Round?.TimeRemaining ?? 0f;
		int mins = (int)(t / 60f);
		int secs = (int)(t % 60f);

		<div class="wiz-round">
			<div class="wiz-round-num">ROUND @roundNum</div>
			<div class="wiz-round-sub">/ @RoundManager.MaxRounds</div>
			<div class="wiz-score">
				<div class="wiz-score-side aurors">
					<div class="wiz-score-lbl">AURORS</div>
					<div class="wiz-score-val">@aurors</div>
				</div>
				<div class="wiz-score-vs">vs</div>
				<div class="wiz-score-side dark">
					<div class="wiz-score-lbl">DARK</div>
					<div class="wiz-score-val">@dark</div>
				</div>
			</div>
			<div class="wiz-timer">@mins:@secs.ToString("D2")</div>
			<div class="wiz-timer-lbl">@GetStateLabel()</div>
		</div>
	};

	RenderFragment RenderConsumablesPanel() => __builder =>
	{
		<div class="wiz-consumables">
			<div class="wiz-panel-title">CONSUMABLES</div>
			<div class="wiz-consumables-balance">@BalanceLabel</div>
			<div class="wiz-consumables-row">
				@RenderPotionCard( ConsumableType.HealthPotion, Player?.ItemSlot1, "wiz-heal-bottle", "+50 HP instantaneamente" )
				@RenderPotionCard( ConsumableType.ManaPotion, Player?.ItemSlot2, "wiz-mana-bottle", "+60 mana instantaneamente" )
			</div>
		</div>
	};

	RenderFragment RenderPotionCard( ConsumableType type, BaseConsumable item, string bottleClass, string description ) => __builder =>
	{
		bool canBuy = CanBuyConsumable( item );
		string status = item == null
			? ""
			: item.Charges >= item.MaxCharges
				? "MAX"
				: $"x{item.Charges}";

		<div class="wiz-potion-card @( canBuy ? "" : "wiz-potion-disabled" )"
		     onclick=@( () => BuyConsumable( type ) )>
			<div class="wiz-potion-bottle @bottleClass"></div>
			<div class="wiz-potion-name">@( item?.ItemName?.ToUpper() ?? "-" )</div>
			<div class="wiz-potion-meta">@description</div>
			<div class="wiz-potion-cost">
				<span>$</span><span>@( item?.PurchaseCost ?? 0 )</span>
			</div>
			<div class="wiz-potion-owned">@status</div>
		</div>
	};

	RenderFragment RenderDetail( int idx ) => __builder =>
	{
		var e = SpellCatalog.All[idx];
		bool selected = Deck.IsOwned( idx );
		int tier = Deck.GetTier( idx );
		bool canUpgradeT1 = selected && tier < 1;
		bool canUpgradeT2 = selected && tier < 2;

		<div class="wiz-detail">
			<div class="wiz-det-name">@e.Name</div>
			<div class="wiz-det-cat">@e.Category.ToUpper()</div>
			<div class="wiz-det-desc">@e.Description</div>
			<div class="wiz-det-stats">
				<div class="wiz-drow"><span>Affinity</span><span>@e.Affinity</span></div>
				<div class="wiz-drow"><span>Energy</span><span>@e.EnergyCost</span></div>
				<div class="wiz-drow"><span>Cooldown</span><span>@e.BaseCooldown s</span></div>
				<div class="wiz-drow"><span>Mana</span><span>@( e.ManaCost > 0f ? e.ManaCost.ToString() : "-" )</span></div>
			</div>
			<div class="wiz-det-stats">
				<div class="wiz-drow"><span>T1</span><span>@e.TierBehaviors.ElementAtOrDefault( 0 )</span></div>
				<div class="wiz-drow"><span>T2</span><span>@e.TierBehaviors.ElementAtOrDefault( 1 )</span></div>
				<div class="wiz-drow"><span>T3</span><span>@e.TierBehaviors.ElementAtOrDefault( 2 )</span></div>
			</div>
			<div class="wiz-det-acts">
				@if ( !selected )
				{
					<button class="wiz-btn-buy" onclick=@( () => AddToBuild( idx ) )>
						ADD TO BUILD
					</button>
				}
				else
				{
					<button class="wiz-btn-sell" onclick=@( () => RemoveFromBuild( idx ) )>
						REMOVE FROM BUILD
					</button>

					@if ( canUpgradeT1 )
					{
						<button class="wiz-btn-up" onclick=@( () => Upgrade( idx, 1 ) )>
							UNLOCK TIER 2
						</button>
					}

					@if ( canUpgradeT2 )
					{
						<button class="wiz-btn-up" onclick=@( () => Upgrade( idx, 2 ) )>
							UNLOCK TIER 3
						</button>
					}

					@if ( tier >= 2 )
					{
						<div class="wiz-maxed">MAXIMIZED</div>
					}
				}
			</div>
		</div>
	};

	// ─── Actions ──────────────────────────────────────────────────────

	void SelectSpell( int idx )
	{
		if ( PendingSlot >= 0 )
		{
			if ( Deck?.IsOwned( idx ) == true )
			{
				Deck.ClientAssign( PendingSlot, idx );
				PendingSlot = -1;
			}

			return;
		}

		SelectedIdx = SelectedIdx == idx ? -1 : idx;
	}

	void ClickSlot( int slot )
	{
		if ( PendingSlot == slot )
		{
			PendingSlot = -1;
			return;
		}

		if ( SelectedIdx >= 0 && Deck != null && Deck.IsOwned( SelectedIdx ) )
		{
			Deck.ClientAssign( slot, SelectedIdx );
			SelectedIdx = -1;
		}
		else
		{
			PendingSlot = slot;
		}
	}

	void AddToBuild( int idx )
	{
		Deck?.ClientSelect( idx );
	}

	void RemoveFromBuild( int idx )
	{
		Deck?.ClientDeselect( idx );
		if ( SelectedIdx == idx )
			SelectedIdx = -1;
	}

	void Upgrade( int idx, int tier )
	{
		Deck?.ClientUpgrade( idx, tier );
	}

	void Unassign( int slot )
	{
		Deck?.ClientUnassign( slot );
	}

	bool CanBuyConsumable( BaseConsumable item )
	{
		return item != null
			&& Player?.Client != null
			&& Player.Client.BuyMenuMode != BuyMenuMode.Disabled
			&& item.Charges < item.MaxCharges
			&& Player.Client.Balance >= item.PurchaseCost;
	}

	void BuyConsumable( ConsumableType type )
	{
		Player?.ClientBuyConsumable( type );
	}

	string BuildImageStyle( string imagePath )
	{
		return string.IsNullOrWhiteSpace( imagePath )
			? "background-image: none;"
			: $"background-image: url(\"{imagePath}\");";
	}

	protected override int BuildHash()
	{
		var buildHash = HashCode.Combine(
			Round?.State,
			Round?.CurrentRound,
			IsOpen,
			Build?.Affinity,
			Build?.Discipline,
			Build?.Passive,
			Validation?.EnergyUsed,
			Validation?.Errors.Count
		);

		buildHash = HashCode.Combine( buildHash,
			Round?.EnableAffinity,
			Round?.EnableDiscipline,
			Round?.EnablePassive
		);

		return HashCode.Combine(
			buildHash,
			Deck?.OwnedMask,
			Deck?.Slot0Idx,
			Player?.Client?.Balance ?? 0,
			Player?.ItemSlot1?.Charges ?? 0,
			Player?.ItemSlot2?.Charges ?? 0,
			SelectedIdx,
			(int)ActiveTab
		);
	}
}
