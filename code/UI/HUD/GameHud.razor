@using Sandbox;
@using Sandbox.UI;

@namespace Warlocks.UI
@inherits PanelComponent


<root class="game-hud">

	@if ( Player != null && Player.IsAlive )
	{
		@* ── Bottom Bar ───────────────────────────────────────────── *@
		<div class="hud-bottom">

			@* HP + Shield + Mana *@
			<Vitals />

			@* Abilities Q E R F *@
			<div class="abilities">
				@RenderAbilitySlot( "Q", _deck.GetSlot(0) )
				@RenderAbilitySlot( "E", _deck.GetSlot(1) )
				@RenderAbilitySlot( "R", _deck.GetSlot(2) )
				@RenderAbilitySlot( "F", _deck.GetSlot(3) )
			</div>

			@* Itens *@
			<div class="item-slots">
				@RenderItemSlot( "1", Player.ItemSlot1 )
				@RenderItemSlot( "2", Player.ItemSlot2 )
			</div>

			@* Galeões *@
			<div class="galleons">
				<div class="galleon-icon">G</div>
				<div class="galleon-amount">@Player.Galleons</div>
			</div>
		</div>

		@* ── Top Bar ──────────────────────────────────────────────── *@
		<div class="hud-top">
			<div class="score auror-score">@( Round?.AurorScore ?? 0 )</div>
			<div class="round-info">
				<div class="round-num">ROUND @( Round?.CurrentRound ?? 0 ) / @RoundManager.MaxRounds</div>
				<div class="round-state">@( GetStateLabel() )</div>
				<div class="round-timer @( IsLowTime ? "timer-low" : "" )">@( TimerLabel )</div>
			</div>
			<div class="score comensal-score">@( Round?.ComensalScore ?? 0 )</div>
		</div>

		@* ── Horcrux timer (quando plantada) ─────────────────────── *@
		@{
			var plantedSite = PlantedHorcrux;
		}
		@if ( plantedSite != null )
		{
			<div class="horcrux-timer">
				<div class="horcrux-label">HORCRUX</div>
				<div class="horcrux-countdown @( plantedSite.TimeUntilExplosion < 10f ? "critical" : "" )">
					@plantedSite.TimeUntilExplosion.ToString( "0.0" )
				</div>
			</div>
		}

		@* ── Burning indicator ────────────────────────────────────── *@
		@if ( Player.BurningEndTime > Time.Now )
		{
			<div class="status-effect burning">BURNING</div>
		}

		@* ── Crosshair ────────────────────────────────────────────── *@
		<div class="crosshair">
			<div class="cross-h"></div>
			<div class="cross-v"></div>
		</div>
	}
	else if ( Player != null && !Player.IsAlive )
	{
		<div class="dead-screen">
			<div class="dead-text">ELIMINADO</div>
			<div class="dead-sub">Aguarde o próximo round</div>
		</div>
	}

</root>

@code {
	PlayerPawn Player => PlayerPawn.Local;
	SpellsDeck _deck => Player.SpellsDeck;
	RoundManager Round => RoundManager.Instance;

	HorcruxSite PlantedHorcrux => Game.ActiveScene
		.GetAllComponents<HorcruxSite>()
		.FirstOrDefault( s => s.IsPlanted && !s.IsDefused && !s.HasExploded );

	float TimeRemaining => Round?.TimeRemaining ?? 0f;
	bool IsLowTime => TimeRemaining < 10f && Round?.State == RoundState.Combat;

	string TimerLabel
	{
		get
		{
			if ( Round == null ) return "–";
			int mins = (int)(TimeRemaining / 60f);
			int secs = (int)(TimeRemaining % 60f);
			return $"{mins}:{secs:00}";
		}
	}

	string GetStateLabel() => Round?.State switch
	{
		RoundState.BuyPhase  => "FASE DE COMPRA",
		RoundState.Combat    => "COMBATE",
		RoundState.PostRound => "FIM DE ROUND",
		RoundState.MatchEnd  => "PARTIDA ENCERRADA",
		_ => ""
	};

	RenderFragment RenderAbilitySlot( string key, BaseSpell spell ) => __builder =>
	{
		bool ready = spell?.IsReady ?? true;
		<div class="ability-slot @( ready ? "ready" : "cooling" )">
			<div class="ability-key">@key</div>
			<div class="ability-name">@( spell?.SpellName ?? "–" )</div>
			@if ( !ready )
			{
				<div class="ability-cd">@( spell?.CooldownRemaining.ToString( "0.0" ) )s</div>
			}
		</div>
	};

	RenderFragment RenderItemSlot( string key, BaseConsumable item ) => __builder =>
	{
		<div class="item-slot @( item?.IsUsed == true ? "item-used" : "" )">
			<div class="item-key">@key</div>
			<div class="item-name">@( item?.ItemName ?? "–" )</div>
		</div>
	};

	protected override int BuildHash() => System.HashCode.Combine(
		Player?.Galleons,
		Player?.IsAlive,
		Round?.TimeRemaining,
		Round?.State
	);
}
