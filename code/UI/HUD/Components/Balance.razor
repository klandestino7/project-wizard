@namespace Warlocks.UI
@inherits Panel
@attribute [StyleSheet]

@if ( !Player.IsValid() ) return;

<root class="row">
    <InputHint Action="BuyMenu" class="small @(!CanOpen ? "hidden" : "")" Size="@InputGlyphSize.Small" />
    <label class="important">BUILD</label>
</root>

@code
{
    /// The player
    public PlayerPawn Player => Client.IsValid() ? Client.PlayerPawn : null;

    /// The player state
    public Client Client => Client.Viewer;

    public bool CanOpen => Player.CanConfigureBuild;

    protected override int BuildHash()
    {
        if ( !Player.IsValid() ) return 0;
        if ( !Client.IsValid() ) return 0;
        if ( !GameMode.Instance.IsValid() ) return 0;

        return HashCode.Combine(CanOpen, Player?.PlayerBuild?.Affinity, Player?.PlayerBuild?.Discipline);
    }   
}
