@namespace Warlocks.UI
@inherits Panel
@attribute [StyleSheet]

<root class="flex gap-sm justify-center row">
    @if ( HasAssignedTeams )
    {
        <RoundStateTeam Score="@MyTeamScore" Team="@MyTeam" Players="@MyTeamPlayers" iconPosition="Left" />
    }
    else
    {
        <div class="grow"></div>        
    }

    <div class="layout flex column with-background align-center justify-center blur" style="border: 1px solid rgba( black, 0.25 )">
        @if ( IconPath is { } path )
        {
            <Icon File="@path" size="64" />
        }
        else
        {
            @* <label class="small slight">@Status</label> *@
            @if (Time.HasValue)
            {
                <label class="uppercase">@RenderRoundInfo()</label>
            }
        }
    </div>

    @if ( HasAssignedTeams )
    {
        <RoundStateTeam Score="@EnemyTeamScore" Team="@EnemyTeam" Players="@EnemyTeamPlayers" iconPosition="Right" />
    }
    else
    {
        <div class="grow"></div>
    }
</root>

@code
{
    private Client LocalClient => Client.Local;
    private Client EffectiveClient => LocalClient?.IsValid() == true ? LocalClient : Client.Viewer;
    private Team MyTeam => EffectiveClient?.Team ?? Team.Unassigned;
    private Team EnemyTeam => MyTeam == Team.Unassigned ? Team.Unassigned : MyTeam.GetOpponents();
    private bool HasAssignedTeams => MyTeam != Team.Unassigned && EnemyTeam != Team.Unassigned;
	RoundManager Round => RoundManager.Instance;

    private string MyTeamScore { get; set; } = "0";
    private string EnemyTeamScore { get; set; } = "0";

    private List<Client> MyTeamPlayers { get; } = new();
    private List<Client> EnemyTeamPlayers { get; } = new();

    public string Status => GameMode.Instance?.IsValid() == true ? GameMode.Instance.DisplayedStatus : "";
    public string IconPath => GameMode.Instance?.IsValid() == true ? GameMode.Instance.Get<ShowStatusIcon>()?.IconPath : "";
    public TimeSpan? Time => GameMode.Instance?.IsValid() == true ? GameMode.Instance.DisplayedTime : null;


    RenderFragment RenderRoundInfo() => __builder =>
	{
		<!-- int roundNum = Round?.CurrentRound ?? 0;
		int aurors = Round?.AurorScore ?? 0;
		int dark = Round?.ComensalScore ?? 0; -->
		float t = Round?.TimeRemaining ?? 0f;
		int mins = (int)(t / 60f);
		int secs = (int)(t % 60f);

		<label class="uppercase">@mins:@secs.ToString("D2")</label>
	};


    private void OnSecondElapsed()
    {
        // TODO: hook this up to a place where we can conditionally activate the beeping
        // if ( storedTime <= 5 )
        // {
        //     var snd = Sound.Play( storedTime == 0 ? "countdown_activate" : "countdown_beep" );
        //     snd.TargetMixer = Sandbox.Audio.Mixer.FindMixerByName( "UI" );
        // }
    }

    private int storedTime;
    public override void Tick()
    {
        if ( EffectiveClient?.IsValid() != true )
            return;

        if ( Time.HasValue )
        {
            var timeInSeconds = (int)Time.Value.TotalSeconds;
            if ( storedTime != timeInSeconds )
            {
                storedTime = timeInSeconds;
                OnSecondElapsed();
            }
        }

        MyTeamPlayers.Clear();
        EnemyTeamPlayers.Clear();

        if ( !HasAssignedTeams )
            return;

        if ( Round?.IsValid() == true )
        {
            MyTeamScore = MyTeam == Team.Aurors
                ? Round.AurorScore.ToString()
                : Round.ComensalScore.ToString();

            EnemyTeamScore = EnemyTeam == Team.Aurors
                ? Round.AurorScore.ToString()
                : Round.ComensalScore.ToString();
        }
        else
        {
            MyTeamScore = null;
            EnemyTeamScore = null;
        }

        MyTeamPlayers.AddRange( GameUtils.GetPlayers( MyTeam ) );
        EnemyTeamPlayers.AddRange( GameUtils.GetPlayers( EnemyTeam ) );
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();

        hash.Add( EffectiveClient?.Id );
        hash.Add( MyTeam );
        hash.Add( EnemyTeam );

        hash.Add( Status );
        hash.Add( IconPath );
        hash.Add( Time );
        hash.Add( Time?.TotalSeconds );
        hash.Add( Round?.AurorScore );
        hash.Add( Round?.ComensalScore );

        foreach ( var player in MyTeamPlayers )
        {
            hash.Add( player.Id );
            hash.Add( player.Team );
        }

        foreach ( var player in EnemyTeamPlayers )
        {
            hash.Add( player.Id );
            hash.Add( player.Team );
        }

        return hash.ToHashCode();
    }
}
