@using Sandbox;
@using Sandbox.UI;

@namespace Warlocks.UI
@inherits Panel
@attribute [StyleSheet]


<root>
	@if ( Player != null && Player.IsAlive )
	{
        @* HP + Shield + Mana *@
        <div class="status-bars">
            <div class="bar-label">HP @Health</div>
            @* <div class="bar-track">
                <div class="bar-fill hp-fill" style="width: @( HealthPercent )%"></div>
            </div> *@
            @* <div class="bar-value"></div> *@

            @if ( Shield > 0 )
            {
                <div class="bar-label shield-label">SHIELD @Shield</div>
                @* <div class="bar-track">
                    <div class="bar-fill shield-fill" style="width: @( ShieldPercent )%"></div>
                </div> *@
                @* <div class="bar-value"> </div> *@
            }

            <div class="bar-label mana-label">MANA @( (int)(Mana) )</div>
            @* <div class="bar-track">
                <div class="bar-fill mana-fill" style="width: @( ManaPercent )%"></div>
            </div> *@
            @* <div class="bar-value"></div> *@
        </div>
	}
</root>

@code {

    public Pawn Pawn => Client.Viewer.Pawn;
    public HealthComponent HealthComponent => Pawn.HealthComponent;
    public int Health => HealthComponent?.Health.CeilToInt() ?? 0;
    public int Shield => HealthComponent?.Shield.CeilToInt() ?? 0;

	PlayerPawn Player => PlayerPawn.Local;

	float Mana => Player?.ManaSystem?.Mana ?? 0f;
	float ManaPercent => Mana / ManaSystem.MaxMana * 100f;

	protected override int BuildHash() => System.HashCode.Combine(
		Health,
		Shield
	);
}
